# ============================================================
# Server
# ============================================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ============================================================
# Database (PostgreSQL)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portfolio_db
DB_SSL_MODE=disable

# ============================================================
# JWT — CHANGE BOTH SECRETS IN PRODUCTION
# Use: openssl rand -hex 32
# ============================================================
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_EXP_MIN=15
JWT_REFRESH_EXP_DAY=30

# ============================================================
# SMTP Email (for contact form notifications)
# For Gmail: use an App Password, not your account password
# https://myaccount.google.com/apppasswords
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Portfolio Contact

# ============================================================
# App
# ============================================================
APP_ENV=development
FRONTEND_URL=http://localhost:5173
